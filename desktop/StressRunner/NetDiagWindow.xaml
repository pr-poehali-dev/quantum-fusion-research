<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="StressRunner.NetDiagWindow"
    Title="Диагностика сети" Height="520" Width="640" MinHeight="320" MinWidth="420"
    WindowStartupLocation="CenterOwner"
    Background="{DynamicResource Bg}"
    FontFamily="Segoe UI">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock x:Name="StatusDot" Text="●" FontSize="16" Foreground="{DynamicResource FgMuted}" VerticalAlignment="Center"/>
            <TextBlock x:Name="Title2" Text="Проверка подключения к сайту…" FontSize="16" FontWeight="SemiBold" Margin="9,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>

        <Border Grid.Row="1" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="10">
            <ScrollViewer x:Name="Scroll" Margin="6" VerticalScrollBarVisibility="Auto">
                <TextBox x:Name="LogBox" IsReadOnly="True" Background="Transparent" Foreground="{DynamicResource Fg}"
                         BorderThickness="0" FontFamily="Consolas" FontSize="12.5" TextWrapping="Wrap" Padding="8"/>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
            <Button x:Name="RetryBtn" Content="↻ Повторить" Style="{StaticResource PrimaryButton}"/>
            <Button x:Name="CopyBtn" Content="Скопировать отчёт" Margin="10,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>
