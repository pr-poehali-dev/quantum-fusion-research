<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="StressRunner.AuthWindow"
    Title="Авторизация" Height="430" Width="440"
    WindowStartupLocation="CenterScreen"
    ResizeMode="NoResize"
    Background="{StaticResource Bg}"
    FontFamily="Segoe UI">

    <Border Margin="0" Background="{StaticResource Bg}">
        <StackPanel Margin="28">
            <StackPanel Orientation="Horizontal" Margin="0,4,0,6">
                <Border Width="38" Height="38" CornerRadius="10" Background="{StaticResource Primary}">
                    <TextBlock Text="S" Foreground="White" FontWeight="Bold" FontSize="20"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Авторизация" FontSize="20" FontWeight="SemiBold"
                           Margin="12,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="Подключение к сайту в один клик. Введи секретный ключ и имя этого ПК."
                       Foreground="{StaticResource FgMuted}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,20"/>

            <TextBlock Text="СЕКРЕТНЫЙ КЛЮЧ (STRESS_INGEST_TOKEN)" FontSize="10" Foreground="{StaticResource FgMuted}" Margin="2,0,0,6"/>
            <Border Background="{StaticResource Muted}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="8">
                <PasswordBox x:Name="TokenBox" Margin="10,8" Background="Transparent" Foreground="{StaticResource Fg}"
                             BorderThickness="0" FontSize="13"/>
            </Border>

            <TextBlock Text="НАЗВАНИЕ ПК" FontSize="10" Foreground="{StaticResource FgMuted}" Margin="2,16,0,6"/>
            <Border Background="{StaticResource Muted}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="8">
                <TextBox x:Name="MachineBox" Margin="10,8" Background="Transparent" Foreground="{StaticResource Fg}"
                         BorderThickness="0" FontSize="13"/>
            </Border>

            <TextBlock x:Name="StatusText" Text="" Margin="2,16,0,0" FontSize="12" TextWrapping="Wrap"
                       Foreground="{StaticResource Primary}"/>

            <Button x:Name="AuthBtn" Style="{StaticResource PrimaryButton}" Content="Авторизоваться"
                    FontSize="14" Margin="0,18,0,0"/>
            <Button x:Name="CancelBtn" Content="Отмена" Margin="0,10,0,0"/>
        </StackPanel>
    </Border>
</Window>
