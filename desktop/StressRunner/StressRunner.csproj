<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>StressRunner</AssemblyName>
    <RootNamespace>StressRunner</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Чтобы собрать один самодостаточный .exe — см. README (publish) -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <!-- Локальная БД результатов на компе -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.0" />
    <!-- Чтение сенсоров HWiNFO из реестра -->
    <PackageReference Include="Microsoft.Win32.Registry" Version="5.0.0" />
  </ItemGroup>

</Project>
