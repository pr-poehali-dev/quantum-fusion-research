<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>StressRunner</AssemblyName>
    <RootNamespace>StressRunner</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- ── Портативная сборка: ОДИН самодостаточный .exe ──
         Всё (рантайм .NET + dll) запаковано внутрь exe. На целевом ПК
         НИЧЕГО ставить не нужно. Папка переносится на флешке как есть. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- Локальная БД результатов на компе -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.0" />
    <!-- Чтение сенсоров HWiNFO из реестра -->
    <PackageReference Include="Microsoft.Win32.Registry" Version="5.0.0" />
    <!-- Кодировка Windows-1251 для меток HWiNFO -->
    <PackageReference Include="System.Text.Encoding.CodePages" Version="8.0.0" />
  </ItemGroup>

</Project>