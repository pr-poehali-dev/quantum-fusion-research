<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="StressRunner.MainWindow"
    Title="StressRunner" Height="680" Width="1040"
    WindowStartupLocation="CenterScreen"
    Background="{StaticResource Bg}"
    FontFamily="Segoe UI">

    <Grid Margin="0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ── Левая панель управления ── -->
        <Border Grid.Column="0" Background="#080808" BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0">
            <StackPanel Margin="22">
                <StackPanel Orientation="Horizontal" Margin="0,4,0,24">
                    <Border Width="34" Height="34" CornerRadius="9" Background="{StaticResource Primary}">
                        <TextBlock Text="S" Foreground="White" FontWeight="Bold" FontSize="18"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="StressRunner" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock x:Name="MachineLabel" Text="—" FontSize="11" Foreground="{StaticResource FgMuted}"/>
                    </StackPanel>
                </StackPanel>

                <TextBlock Text="ПРОФИЛЬ" FontSize="10" Foreground="{StaticResource FgMuted}" Margin="2,0,0,6"/>
                <ComboBox x:Name="ProfileBox" Margin="0,0,0,10"/>
                <Button x:Name="ReloadBtn" Content="↻ Обновить профили с сайта" Margin="0,0,0,18"
                        HorizontalContentAlignment="Left" FontSize="12"/>

                <Button x:Name="StartBtn" Style="{StaticResource PrimaryButton}" Content="▶  СТАРТ" FontSize="15"/>
                <Button x:Name="StopBtn" Content="■  Остановить" Margin="0,10,0,0" IsEnabled="False"/>

                <Border Height="1" Background="{StaticResource Border}" Margin="0,22"/>

                <TextBlock Text="ДАТЧИКИ (HWiNFO)" FontSize="10" Foreground="{StaticResource FgMuted}" Margin="2,0,0,10"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,6,10">
                        <TextBlock Text="CPU нагрузка" FontSize="10" Foreground="{StaticResource FgMuted}"/>
                        <TextBlock x:Name="CpuLoadVal" Text="—" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource Primary}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="6,0,0,10">
                        <TextBlock Text="CPU °C" FontSize="10" Foreground="{StaticResource FgMuted}"/>
                        <TextBlock x:Name="CpuTempVal" Text="—" FontSize="22" FontWeight="SemiBold"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,6,0">
                        <TextBlock Text="GPU нагрузка" FontSize="10" Foreground="{StaticResource FgMuted}"/>
                        <TextBlock x:Name="GpuLoadVal" Text="—" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource Accent}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="6,0,0,0">
                        <TextBlock Text="GPU °C" FontSize="10" Foreground="{StaticResource FgMuted}"/>
                        <TextBlock x:Name="GpuTempVal" Text="—" FontSize="22" FontWeight="SemiBold"/>
                    </StackPanel>
                </Grid>

                <TextBlock x:Name="HwInfoHint" Margin="0,14,0,0" FontSize="10" TextWrapping="Wrap"
                           Foreground="{StaticResource FgMuted}"
                           Text="Для графика включи в HWiNFO «Shared Memory Support» или добавь сенсоры в Gadget."/>
            </StackPanel>
        </Border>

        <!-- ── Правая часть: график + прогресс + лог ── -->
        <Grid Grid.Column="1" Margin="22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="240"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Заголовок текущего теста -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
                <TextBlock x:Name="StatusDot" Text="●" FontSize="16" Foreground="{StaticResource FgMuted}" VerticalAlignment="Center"/>
                <TextBlock x:Name="CurrentTest" Text="Готов к запуску" FontSize="16" FontWeight="SemiBold" Margin="9,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- График загрузки -->
            <Border Grid.Row="1" Background="{StaticResource Card}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="12">
                <Grid Margin="14">
                    <TextBlock Text="Загрузка, %" FontSize="11" Foreground="{StaticResource FgMuted}" VerticalAlignment="Top"/>
                    <Canvas x:Name="GraphCanvas" ClipToBounds="True" Margin="0,18,0,0"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Right">
                        <TextBlock Text="■ CPU" Foreground="{StaticResource Primary}" FontSize="11" Margin="0,0,12,0"/>
                        <TextBlock Text="■ GPU" Foreground="{StaticResource Accent}" FontSize="11"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Прогресс -->
            <Grid Grid.Row="2" Margin="0,16,0,0">
                <Border Height="10" Background="{StaticResource Muted}" CornerRadius="5"/>
                <Border x:Name="ProgressFill" Height="10" Width="0" HorizontalAlignment="Left" CornerRadius="5">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="{StaticResource PrimaryColor}" Offset="0"/>
                            <GradientStop Color="{StaticResource AccentColor}" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
            </Grid>

            <!-- Лог -->
            <Border Grid.Row="3" Margin="0,16,0,0" Background="{StaticResource Card}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="12">
                <ScrollViewer x:Name="LogScroll" Margin="6" VerticalScrollBarVisibility="Auto">
                    <TextBox x:Name="LogBox" IsReadOnly="True" Background="Transparent" Foreground="{StaticResource Fg}"
                             BorderThickness="0" FontFamily="Consolas" FontSize="12.5"
                             TextWrapping="Wrap" Padding="8"/>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
