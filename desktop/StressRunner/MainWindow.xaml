<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="StressRunner.MainWindow"
    Title="StressRunner" Height="700" Width="1040"
    WindowStartupLocation="CenterScreen"
    Background="{DynamicResource Bg}"
    FontFamily="Segoe UI">

    <Window.LayoutTransform>
        <ScaleTransform x:Name="UiScale" ScaleX="1" ScaleY="1"/>
    </Window.LayoutTransform>

    <Grid Margin="0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ── Левая панель управления ── -->
        <Border Grid.Column="0" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0">
            <StackPanel Margin="22">
                <Grid Margin="0,4,0,20">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="34" Height="34" CornerRadius="9" Background="{DynamicResource Primary}">
                            <TextBlock Text="S" Foreground="White" FontWeight="Bold" FontSize="18"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="StressRunner" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock x:Name="MachineLabel" Text="—" FontSize="11" Foreground="{DynamicResource FgMuted}"/>
                        </StackPanel>
                    </StackPanel>
                    <!-- Масштаб + тема -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <Button x:Name="ScaleDownBtn" Width="30" Height="34" Padding="0" Content="−" FontSize="17" ToolTip="Уменьшить масштаб"/>
                        <Button x:Name="ScaleUpBtn" Width="30" Height="34" Padding="0" Margin="4,0,0,0" Content="+" FontSize="15" ToolTip="Увеличить масштаб"/>
                        <Button x:Name="ThemeBtn" Width="34" Height="34" Padding="0" Margin="6,0,0,0" ToolTip="Тема оформления" Content="🎨" FontSize="15"/>
                    </StackPanel>
                </Grid>

                <!-- Статус авторизации -->
                <Border x:Name="AuthBadge" CornerRadius="8" Padding="11,8" Margin="0,0,0,14"
                        Background="{DynamicResource Muted}" BorderBrush="{DynamicResource Border}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock x:Name="AuthStatus" Text="Не авторизован" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Primary}"/>
                        <TextBlock x:Name="AuthSub" Text="Подключись к сайту, чтобы слать результаты" FontSize="11" Foreground="{DynamicResource FgMuted}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
                <Button x:Name="AuthBtn" Content="🔑 Авторизоваться" Margin="0,0,0,18"
                        HorizontalContentAlignment="Left" FontSize="12"/>

                <TextBlock Text="ПРОФИЛЬ" FontSize="10" Foreground="{DynamicResource FgMuted}" Margin="2,0,0,6"/>
                <ComboBox x:Name="ProfileBox" Margin="0,0,0,10"/>
                <Button x:Name="ReloadBtn" Content="↻ Обновить профили с сайта" Margin="0,0,0,18"
                        HorizontalContentAlignment="Left" FontSize="12"/>

                <Button x:Name="StartBtn" Style="{StaticResource PrimaryButton}" Content="▶  СТАРТ" FontSize="15"/>
                <Button x:Name="StopBtn" Content="■  Остановить" Margin="0,10,0,0" IsEnabled="False"/>
                <Button x:Name="OpenTestsBtn" Content="📂 Папка StressTests" Margin="0,10,0,0"
                        HorizontalContentAlignment="Left" FontSize="12"/>
                <Button x:Name="DebugBtn" Content="🔍 Датчики (отладка)" Margin="0,10,0,0"
                        HorizontalContentAlignment="Left" FontSize="12"/>

                <Border Height="1" Background="{DynamicResource Border}" Margin="0,20"/>

                <TextBlock Text="ДАТЧИКИ (HWiNFO)" FontSize="10" Foreground="{DynamicResource FgMuted}" Margin="2,0,0,10"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,6,10">
                        <TextBlock Text="CPU нагрузка" FontSize="10" Foreground="{DynamicResource FgMuted}"/>
                        <TextBlock x:Name="CpuLoadVal" Text="—" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource Primary}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="6,0,0,10">
                        <TextBlock Text="CPU °C" FontSize="10" Foreground="{DynamicResource FgMuted}"/>
                        <TextBlock x:Name="CpuTempVal" Text="—" FontSize="22" FontWeight="SemiBold"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,6,0">
                        <TextBlock Text="GPU нагрузка" FontSize="10" Foreground="{DynamicResource FgMuted}"/>
                        <TextBlock x:Name="GpuLoadVal" Text="—" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource Accent}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="6,0,0,0">
                        <TextBlock Text="GPU °C" FontSize="10" Foreground="{DynamicResource FgMuted}"/>
                        <TextBlock x:Name="GpuTempVal" Text="—" FontSize="22" FontWeight="SemiBold"/>
                    </StackPanel>
                </Grid>

                <TextBlock x:Name="HwInfoHint" Margin="0,14,0,0" FontSize="10" TextWrapping="Wrap"
                           Foreground="{DynamicResource FgMuted}"
                           Text="Для графика включи в HWiNFO «Shared Memory Support» или добавь сенсоры в Gadget."/>
            </StackPanel>
        </Border>

        <!-- ── Правая часть: график + прогресс + лог ── -->
        <Grid Grid.Column="1" Margin="22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="240"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
                <TextBlock x:Name="StatusDot" Text="●" FontSize="16" Foreground="{DynamicResource FgMuted}" VerticalAlignment="Center"/>
                <TextBlock x:Name="CurrentTest" Text="Готов к запуску" FontSize="16" FontWeight="SemiBold" Margin="9,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- График загрузки -->
            <Border Grid.Row="1" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="12">
                <Grid Margin="14">
                    <TextBlock Text="Загрузка, %" FontSize="11" Foreground="{DynamicResource FgMuted}" VerticalAlignment="Top"/>
                    <Canvas x:Name="GraphCanvas" ClipToBounds="True" Margin="0,18,0,0"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Right">
                        <TextBlock Text="■ CPU" Foreground="{DynamicResource Primary}" FontSize="11" Margin="0,0,12,0"/>
                        <TextBlock Text="■ GPU" Foreground="{DynamicResource Accent}" FontSize="11"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Прогресс -->
            <Grid Grid.Row="2" Margin="0,16,0,0">
                <Border Height="10" Background="{DynamicResource Muted}" CornerRadius="5"/>
                <Border x:Name="ProgressFill" Height="10" Width="0" HorizontalAlignment="Left" CornerRadius="5"
                        Background="{DynamicResource Primary}"/>
            </Grid>

            <!-- Лог -->
            <Border Grid.Row="3" Margin="0,16,0,0" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="12">
                <ScrollViewer x:Name="LogScroll" Margin="6" VerticalScrollBarVisibility="Auto">
                    <TextBox x:Name="LogBox" IsReadOnly="True" Background="Transparent" Foreground="{DynamicResource Fg}"
                             BorderThickness="0" FontFamily="Consolas" FontSize="12.5"
                             TextWrapping="Wrap" Padding="8"/>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>