    },
    {
      "name": "Confirm code - wrong secret",
      "method": "POST",
      "path": "/?action=confirm",
      "body": {"bot_secret": "wrong", "code": "123456", "tg_id": 12345},
      "expectedStatus": 403,
      "bodyMatcher": "partial"
    }
  ]
}
