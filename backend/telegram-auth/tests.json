{
  "tests": [
    {
      "name": "Health check",
      "method": "GET",
      "path": "/",
      "expectedStatus": 200,
      "expectedBody": {"ok": true},
      "bodyMatcher": "partial"
    },
    {
      "name": "Generate code - unauthorized",
      "method": "GET",
      "path": "/?action=generate",
      "expectedStatus": 401,
