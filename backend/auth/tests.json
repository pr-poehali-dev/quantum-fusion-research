{
  "tests": [
    {
      "name": "Me without session",
      "method": "GET",
      "path": "/?action=me",
      "expectedStatus": 401
    },
    {
      "name": "Admin login wrong password",
      "method": "POST",
      "path": "/?action=admin_login",
      "body": {
        "ak": "definitely-wrong-password"
      },
      "expectedStatus": 200
    },
    {
      "name": "Build by unknown short code returns 404",
      "method": "GET",
      "path": "/?action=build&code=zzzzzz",
      "expectedStatus": 404
    },
    {
      "name": "Admin companies without key forbidden",
      "method": "GET",
      "path": "/?action=admin_companies&ak=wrong",
      "expectedStatus": 403
    },
    {
      "name": "Company save without key forbidden",
      "method": "POST",
      "path": "/?action=admin_company_save",
      "body": {
        "ak": "wrong",
        "name": "__test__"
      },
      "expectedStatus": 403
    },
    {
      "name": "Company delete without key forbidden",
      "method": "DELETE",
      "path": "/?action=admin_company_delete&id=1&ak=wrong",
      "expectedStatus": 403
    },
    {
      "name": "Admin user builds without key forbidden",
      "method": "GET",
      "path": "/?action=admin_user_builds&ak=wrong",
      "expectedStatus": 403
    },
    {
      "name": "Admin user build update without key forbidden",
      "method": "POST",
      "path": "/?action=admin_user_build_update",
      "body": {
        "ak": "wrong",
        "build_id": 1,
        "op": "delete"
      },
      "expectedStatus": 403
    }
  ]
}